# Copy to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env
#
# Used by extract_logits.py, demo scripts, and start_vllm.sh (via load_dotenv / source).

# --- Cloud teachers (extract_logits.py) ---

OPENAI_API_KEY=sk-...
# Optional: University of Edinburgh ELM instead of api.openai.com
# OPENAI_BASE_URL=https://...

OPENROUTER_API_KEY=sk-or-v1-...

RUNPOD_API_KEY=rpa_...

# --- Local Ollama (optional) ---
# Start with `ollama serve`. Any non-empty value works for the API key.
OLLAMA_API_KEY=ollama

# --- Local vLLM client / server ---
# Start the server first: ./start_vllm.sh
# Must match --api-key in start_vllm.sh (default: mysecretkey).
VLLM_API_KEY=mysecretkey
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Model served by ./start_vllm.sh. Use the matching teacher preset:
#   Qwen/Qwen3.5-27B                                    -> qwen3.5-27b-vllm
#   google/gemma-4-26B-A4B-it                           -> gemma4-26b-vllm
#   mistralai/Mistral-Small-3.2-24B-Instruct-2506      -> mistral-small-24b-vllm
VLLM_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_LOGPROBS=262144
VLLM_MAX_NUM_SEQS=256
# Gemma-only parser/tool settings. Leave unset for Qwen.
# VLLM_ENABLE_AUTO_TOOL_CHOICE=1
# VLLM_REASONING_PARSER=gemma4
# VLLM_TOOL_CALL_PARSER=gemma4
# For RunPod proxy:
# VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1

# --- vLLM server / Hugging Face model download ---
# Required to download gated Hugging Face models, if the selected model needs it.
HF_HOME=/root/.cache/huggingface
HF_TOKEN=hf_your_token_here
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Blackwell (SM 12.x) GPUs: disable FlashInfer sampler when system CUDA toolkit < 12.9.
VLLM_USE_FLASHINFER_SAMPLER=0
